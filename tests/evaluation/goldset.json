{
  "_meta": {
    "version": "1.0",
    "created": "2026-10-09",
    "purpose": "研析通 v3.0 RAGAS/消融/回归金标集。每条覆盖一个真实科研场景，字段语义见下方说明。",
    "field_semantics": {
      "id": "稳定 ID，不要复用",
      "query": "用户原始提问（中文/英文均可）",
      "language": "zh | en",
      "type": "literature=文献综述/对比; fact=事实性问答; number=含具体数值/指标; out_of_scope=库外问题（应拒答）; analysis=数据分析任务",
      "reference_facts": "标准答案必须覆盖的关键事实点（用于 context_recall / 人工抽检）",
      "must_have_citation": "true 时回答必须出现 [n] 形式引用",
      "must_refuse": "true 时回答必须明确表示'知识库中没有'而不是编造",
      "expected_route": "lit=retrieve/supervisor; data=data_analyst; design=experiment_designer; write=writing; review=academic_reviewer",
      "notes": "标注备注"
    }
  },
  "samples": [
