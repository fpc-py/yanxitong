# =============================================================================
# 研析通 v3.0 环境变量示例 — 复制为 .env 并填入真实值
#   cp .env.example .env
# 所有 *_PASSWORD 在生产部署前必须替换；本地开发可保留默认。
# =============================================================================

# ---- LLM API（必填）----
DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# ---- CORS 允许的前端来源（逗号分隔；生产改为你的域名）----
YXT_CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321

# ---- Neo4j ----
NEO4J_PASSWORD=change-me-in-prod

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app

# ---- Grafana ----
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me-grafana

# ---- 沙箱：仅在确知风险时设为 1（默认 docker 不可用时拒绝执行 AI 生成代码）----
# YXT_ALLOW_MOCK_SANDBOX=1
