# --- 模型权重（约 2.3GB，可重新下载，不上传）-------------------
# 重新下载：
#   $env:HF_ENDPOINT = "https://hf-mirror.com"
#   .\.venv\Scripts\huggingface-cli.exe download BAAI/bge-m3 --local-dir models/bge-m3
# 并按 config.yaml -> retriever.embedding_model 指向的目录放置
